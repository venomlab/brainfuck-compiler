{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": true
      }
    },
    {
      "name": "debug",
      "displayName": "Clang Debug",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/clang-linux.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "clang-sanitize",
      "displayName": "Clang Debug with ASan and UBSan",
      "inherits": "debug",
      "cacheVariables": {
        "ENABLE_ASAN_UBSAN": "ON"
      }
    },
    {
      "name": "clang-tsanitize",
      "displayName": "Clang Debug with TSan",
      "inherits": "debug",
      "cacheVariables": {
        "ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "clang-tidy",
      "displayName": "Clang Debug with clang-tidy",
      "inherits": "debug",
      "cacheVariables": {
        "ENABLE_TIDY": "ON"
      }
    },
    {
      "name": "clang-release",
      "displayName": "Clang Release",
      "inherits": "base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/clang-linux.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "gcc-release-w64",
      "displayName": "GCC Release for Windows x86-64",
      "inherits": "base",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "BUILD_TESTING": "OFF",
        "CMAKE_BUILD_TYPE": "Release",
        "VCPKG_CHAINLOAD_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchains/gcc-w64.cmake",
        "VCPKG_MANIFEST_DIR": "${sourceDir}/cmake/vcpkg/w64",
        "VCPKG_MANIFEST_INSTALL": "ON",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-static-release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "clang-sanitize",
      "configurePreset": "clang-sanitize"
    },
    {
      "name": "clang-tsanitize",
      "configurePreset": "clang-tsanitize"
    },
    {
      "name": "clang-tidy",
      "configurePreset": "clang-tidy"
    },
    {
      "name": "clang-release",
      "configurePreset": "clang-release"
    },
    {
      "name": "gcc-release-w64",
      "configurePreset": "gcc-release-w64"
    }
  ],
  "testPresets": [
    {
        "name": "tests",
        "configurePreset": "debug",
        "output": {
            "outputOnFailure": true
        },
        "execution": {
            "jobs": 4,
            "stopOnFailure": false
        }
    },
    {
        "name": "tests-sanitize",
        "configurePreset": "clang-sanitize",
        "output": {
            "outputOnFailure": true
        },
        "execution": {
            "jobs": 4,
            "stopOnFailure": false
        }
    },
    {
        "name": "tests-tsanitize",
        "configurePreset": "clang-tsanitize",
        "output": {
            "outputOnFailure": true
        },
        "execution": {
            "jobs": 4,
            "stopOnFailure": false
        }
    }
  ]
}
